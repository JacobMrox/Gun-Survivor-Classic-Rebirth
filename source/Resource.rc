#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDR_CROSSHAIR_PC     RCDATA "..\\data\\FIXRES\\crosshair_pc.png"
IDR_CROSSHAIR_OLD    RCDATA "..\\data\\FIXRES\\crosshair_old.png"
IDR_CROSSHAIR_PSX    RCDATA "..\\data\\FIXRES\\crosshair_psx.png"
IDR_CROSSHAIR_UC_BIG RCDATA "..\\data\\FIXRES\\crosshair_uc_big.png"
IDR_MISC_BMP         RCDATA "..\\data\\FIXRES\\MISC.BMP"

1 RT_MANIFEST "Fluent.manifest"

IDD_CONFIG_DIALOG DIALOGEX 0, 0, 420, 302
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resident Evil: Survivor - Classic Rebirth 1.1.2"
FONT 9, "Segoe UI"
BEGIN
GROUPBOX        "Graphics", IDC_STATIC, 7, 7, 198, 65
LTEXT           "Resolution:", IDC_STATIC, 15, 22, 40, 8
COMBOBOX        IDC_RES_COMBO, 60, 20, 95, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "FPS Limit:", IDC_STATIC, 15, 55, 35, 8
COMBOBOX        IDC_FPS_COMBO, 60, 52, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "Display FPS Counter", IDC_FPS_COUNTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 40, 100, 10
LTEXT           "Refresh Rate:", IDC_STATIC, 112, 40, 50, 8
EDITTEXT        IDC_REFRESH, 162, 38, 30, 12, ES_NUMBER

GROUPBOX        "Window", IDC_STATIC, 7, 75, 198, 80
CONTROL         "Force Windowed", IDC_WINDOWED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 90, 80, 10
CONTROL         "Borderless Fullscreen", IDC_BORDERLESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 90, 100, 10
CONTROL         "Center Window", IDC_CENTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 105, 80, 10
CONTROL         "Always On Top", IDC_ALWAYS_ONTOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 105, 100, 10
CONTROL         "Lock Cursor", IDC_LOCK_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 120, 80, 10
CONTROL         "Primary Monitor Only", IDC_PRIMARY_MON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 120, 100, 10
CONTROL         "Keep Aspect Ratio", IDC_KEEP_ASPECT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 137, 100, 10

GROUPBOX        "Fixes", IDC_STATIC, 7, 160, 198, 52
CONTROL         "Skip FMV Movies", IDC_SKIP_MOVIES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 177, 100, 10
CONTROL         "Smooth Model Lighting", IDC_SMOOTH_MODEL_LIGHTING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 177, 95, 10
CONTROL         "Lethal Zombie Headshots", IDC_ZOMBIE_HEADSHOTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 194, 130, 10

GROUPBOX        "Crosshair", IDC_STATIC, 212, 7, 201, 148
LTEXT           "Type:", IDC_STATIC, 220, 22, 20, 8
COMBOBOX        IDC_CROSS_COMBO, 245, 20, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "Browse...", IDC_CROSS_BROWSE, 350, 20, 48, 12

LTEXT           "Scale:", IDC_STATIC, 220, 47, 25, 8
CONTROL         "", IDC_CROSS_SCALE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 250, 44, 100, 15
LTEXT           "100%", IDC_CROSS_SCALE_LABEL, 355, 47, 30, 8

LTEXT           "Mouse Sensitivity:", IDC_STATIC, 220, 72, 75, 8
CONTROL         "", IDC_MOUSE_SENSITIVITY, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 290, 69, 75, 15
LTEXT           "100%", IDC_MOUSE_SENSITIVITY_LABEL, 368, 72, 35, 8
CONTROL         "Laser Dot Trail", IDC_LASER_TRAIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 98, 80, 10
PUSHBUTTON      "Laser Color...", IDC_LASER_COLOR, 310, 95, 62, 14

CONTROL         "", IDC_CROSS_PREVIEW, "Static", SS_BITMAP | SS_REALSIZECONTROL | SS_CENTERIMAGE | WS_BORDER, 358, 112, 40, 34

GROUPBOX        "Application", IDC_STATIC, 212, 160, 201, 52
CONTROL         "Show Config on Launch", IDC_SHOW_CONFIG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 177, 110, 10
CONTROL         "Enable Logging", IDC_ENABLE_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 194, 100, 10

CTEXT           "Resident Evil: Survivor - Classic Rebirth 1.1.2 © Jacob Qarooni @Mehrqarox\nGiuseppe Marsiglia @Trigger117", IDC_STATIC, 7, 232, 406, 20, WS_DISABLED

DEFPUSHBUTTON   "Start Game", IDOK, 145, 272, 65, 16
PUSHBUTTON      "Cancel", IDCANCEL, 218, 272, 55, 16
END
