#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 RT_MANIFEST "Fluent.manifest"

IDD_CONFIG_DIALOG DIALOGEX 0, 0, 280, 405
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resident Evil: Survivor - Classic Rebirth 1.1.2"
FONT 9, "Segoe UI"
BEGIN
GROUPBOX        "Graphics", IDC_STATIC, 7, 7, 266, 65
LTEXT           "Resolution:", IDC_STATIC, 15, 22, 40, 8
COMBOBOX        IDC_RES_COMBO, 60, 20, 95, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "FPS Limit:", IDC_STATIC, 165, 22, 35, 8
COMBOBOX        IDC_FPS_COMBO, 205, 20, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "Display FPS Counter", IDC_FPS_COUNTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 40, 100, 10
LTEXT           "Refresh Rate:", IDC_STATIC, 125, 40, 50, 8
EDITTEXT        IDC_REFRESH, 175, 38, 30, 12, ES_NUMBER

GROUPBOX        "Window", IDC_STATIC, 7, 75, 266, 80
CONTROL         "Force Windowed", IDC_WINDOWED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 90, 80, 10
CONTROL         "Borderless Fullscreen", IDC_BORDERLESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 90, 100, 10
CONTROL         "Center Window", IDC_CENTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 105, 80, 10
CONTROL         "Always On Top", IDC_ALWAYS_ONTOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 105, 100, 10
CONTROL         "Lock Cursor", IDC_LOCK_CURSOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 120, 80, 10
CONTROL         "Primary Monitor Only", IDC_PRIMARY_MON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 120, 100, 10
CONTROL         "Keep Aspect Ratio", IDC_KEEP_ASPECT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 137, 100, 10

GROUPBOX        "Fixes", IDC_STATIC, 7, 160, 266, 40
CONTROL         "Skip FMV Movies", IDC_SKIP_MOVIES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 177, 100, 10
CONTROL         "Smooth Model Lighting", IDC_SMOOTH_MODEL_LIGHTING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 177, 115, 10

GROUPBOX        "Crosshair", IDC_STATIC, 7, 205, 266, 115
LTEXT           "Type:", IDC_STATIC, 15, 220, 20, 8
COMBOBOX        IDC_CROSS_COMBO, 40, 218, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "Browse...", IDC_CROSS_BROWSE, 145, 218, 40, 12

LTEXT           "Scale:", IDC_STATIC, 15, 240, 20, 8
CONTROL         "", IDC_CROSS_SCALE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 40, 238, 100, 15
LTEXT           "100%", IDC_CROSS_SCALE_LABEL, 145, 240, 30, 8

LTEXT           "Mouse Sensitivity:", IDC_STATIC, 15, 263, 75, 8
CONTROL         "", IDC_MOUSE_SENSITIVITY, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 90, 260, 100, 15
LTEXT           "100%", IDC_MOUSE_SENSITIVITY_LABEL, 195, 263, 35, 8
CONTROL         "Laser Dot Trail", IDC_LASER_TRAIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 287, 100, 10

CONTROL         "", IDC_CROSS_PREVIEW, "Static", SS_BITMAP | SS_REALSIZECONTROL | SS_CENTERIMAGE | WS_BORDER, 220, 213, 40, 40

GROUPBOX        "Application", IDC_STATIC, 7, 325, 266, 38
CONTROL         "Show Config on Launch", IDC_SHOW_CONFIG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 342, 110, 10
CONTROL         "Enable Logging", IDC_ENABLE_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 342, 100, 10

CTEXT           "Resident Evil: Survivor - Classic Rebirth 1.1.2 © Jacob Qarooni @Mehrqarox\nGiuseppe Marsiglia @Trigger117", IDC_STATIC, 7, 368, 266, 18, WS_DISABLED

DEFPUSHBUTTON   "Start Game", IDOK, 78, 387, 60, 14
PUSHBUTTON      "Cancel", IDCANCEL, 145, 387, 55, 14
END
